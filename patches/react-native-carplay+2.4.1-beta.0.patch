++ (UIImage *)generatePinImageWithLabel:(NSString *)label {
+    CGFloat size = 18.0;
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(size, size)];
+    UIImage *image = [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull rendererContext) {
+        UIBezierPath *circle = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(0, 0, size, size)];
+        [[UIColor colorWithRed:0.0 green:0.48 blue:1.0 alpha:1.0] setFill];
+        [circle fill];
+
+        NSMutableParagraphStyle *style = [[NSMutableParagraphStyle alloc] init];
+        style.alignment = NSTextAlignmentCenter;
+        CGFloat fontSize = label.length > 2 ? 7.0 : (label.length > 1 ? 8.0 : 9.0);
+        NSDictionary *attrs = @{
+            NSFontAttributeName: [UIFont boldSystemFontOfSize:fontSize],
+            NSForegroundColorAttributeName: [UIColor whiteColor],
+            NSParagraphStyleAttributeName: style,
+        };
+        CGSize textSize = [label sizeWithAttributes:attrs];
+        CGRect textRect = CGRectMake(
+            (size - textSize.width) / 2.0,
+            (size - textSize.height) / 2.0,
+            textSize.width,
+            textSize.height
+        );
+        [label drawInRect:textRect withAttributes:attrs];
+    }];
+    return image;
+}
